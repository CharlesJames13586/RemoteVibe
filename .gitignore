# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
package-lock.json.bak

# ── Secrets / local runtime state (never commit) ────────────────────────────
# .env files may hold TURN_SECRET, SIGNAL_URL overrides, etc.
.env
.env.*
!.env.example

# Trusted-device tokens (mac-agent/device-store.js) — contains device labels
# and token hashes for this specific machine; not portable, not secret-safe
# to publish even though tokens are hashed.
devices.json

# 本机签名/公证操作手册（含 Apple ID、Team ID 等个人凭据，仅本地保留）
mac-agent/SIGNING.md

# ── Build artifacts ──────────────────────────────────────────────────────────
dist/
out/
*.tsbuildinfo

# ── Electron ─────────────────────────────────────────────────────────────────
# 注意：mac-agent/build/ 不能忽略，里面放着构建必需的
# entitlements.mac.plist 和 README-dmg.txt。
mac-agent/dist/
mac-agent/out/
*.dmg
*.blockmap
*.pkg

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
logs/

# ── macOS ────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ── Editor / IDE ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── infra: generated/local deployment artifacts (templates in infra/ itself
# are tracked; anything derived from them during an actual deploy is not) ───
infra/*.generated
